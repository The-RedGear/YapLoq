<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Margin="0,0,8,0">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Name="ViewerSearch" Tag="Search assigned viewers"/><Button Name="ViewerEdit" Grid.Column="1" Content="Edit" Margin="8,0,0,0"/><Button Name="ViewerDelete" Grid.Column="2" Content="Delete" Margin="8,0,0,0"/><Button Name="ViewerNew" Grid.Column="3" Content="Add viewer" Margin="8,0,0,0"/></Grid>
 <DataGrid Name="ViewerList" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" CanUserSortColumns="True" MinHeight="90">
  <DataGrid.Columns><DataGridTextColumn Header="VIEWER" Binding="{Binding displayName}" Width="*"/><DataGridTextColumn Header="PLATFORM" Binding="{Binding platform}" Width="95"/><DataGridTextColumn Header="USER ID" Binding="{Binding userId}" Width="120"/><DataGridTextColumn Header="VOICE" Binding="{Binding voiceLabel}" Width="*"/><DataGridTextColumn Header="STATUS" Binding="{Binding status}" Width="100"/></DataGrid.Columns>
 </DataGrid>
 <Border Grid.Row="2" Background="#1E1A27" BorderBrush="#50485C" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0"><StackPanel>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
   <StackPanel Visibility="Collapsed" Margin="0,0,8,0"><TextBlock Text="Platform" Margin="0,0,0,5"/><ComboBox Name="ViewerPlatform" IsEditable="False" SelectedValuePath="Tag" SelectedIndex="0" ToolTip="Choose the viewer's platform">
    <ComboBoxItem Content="Select platform" Tag="" IsEnabled="False"/>
    <ComboBoxItem Content="Twitch" Tag="twitch"/><ComboBoxItem Content="YouTube" Tag="youtube"/><ComboBoxItem Content="Kick" Tag="kick"/>
    <ComboBoxItem Content="Discord" Tag="discord"/><ComboBoxItem Content="TikTok" Tag="tiktok"/><ComboBoxItem Content="Facebook" Tag="facebook"/><ComboBoxItem Content="Trovo" Tag="trovo"/>
   </ComboBox></StackPanel>
   <StackPanel Visibility="Collapsed" Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Stable user ID" Margin="0,0,0,5"/><TextBox Name="ViewerId" Tag="Platform user ID"/></StackPanel>
   <StackPanel Grid.ColumnSpan="3"><TextBlock Text="Username" Margin="0,0,0,5"/><TextBox Name="ViewerName" Tag="Enter a viewer username"/></StackPanel>
  </Grid>
  <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox Name="ViewerVoice" DisplayMemberPath="Label" SelectedValuePath="Value" ToolTip="Default voice or playlist for this viewer"/>
   <Button Name="ViewerReset" Grid.Column="1" Content="Reset" ToolTip="Use assignment rules and the default voice again" Margin="8,0,0,0"/>
   <Button Name="ViewerSave" Grid.Column="2" Content="Save assignment" Margin="8,0,0,0"/>
  </Grid>
  <TextBlock Text="Matches the incoming username exactly, ignoring capitalization. Applies across platforms. Explicit voice selections override this assignment." TextWrapping="Wrap" Foreground="#B9B2C2" Margin="0,8,0,0"/>
 </StackPanel></Border>
 <TextBlock Name="ViewerStatus" Grid.Row="3" Text="Loading viewers..." TextWrapping="Wrap" Foreground="#B9B2C2" Margin="0,8,0,0"/>
</Grid>
